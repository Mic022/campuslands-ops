# Copiar a .env y completar. Nunca subir .env al repositorio.

# Base de datos SQLite (ruta relativa a backend/)
DATABASE_URL=sqlite:///./campus.db

# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# ---------- Autenticación ----------
# desarrollo | produccion (produccion: cookies Secure, sin usuarios de prueba ni /docs)
ENTORNO=desarrollo
# URL pública del frontend (origen permitido y base del enlace de recuperación)
APP_URL=http://localhost:5173
TOKEN_HORAS=8
SESION_RECORDAR_DIAS=14
SESION_INACTIVIDAD_MIN=60
REGISTRO_PUBLICO=true
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=15
# Política de contraseñas
CLAVE_MIN=10
CLAVE_MAYUSCULA=true
CLAVE_MINUSCULA=true
CLAVE_NUMERO=true
CLAVE_SIMBOLO=false
# Recuperación de contraseña: smtp | consola (solo desarrollo) | vacío (deshabilitada)
CORREO_MODO=
RECUPERACION_MIN=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_REMITENTE=
# Usuarios de prueba (ficticios, solo fuera de producción). Si una clave queda vacía, se genera
# una que cumple la política y se muestra una vez en la consola del backend.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Maria Fernanda Cano
ADMIN_CLAVE=
USUARIOS_DEMO=ana,beto
USUARIO_CLAVE=

# ---------- IA ----------
# Proveedor autorizado para la jornada: anthropic | openai | ollama
# Verificar la configuración con:  cd backend && python -m scripts.probar_ia
#
# Claude (Anthropic):   IA_PROVEEDOR=anthropic  IA_MODELO=claude-opus-5-5  IA_API_KEY=<clave>
# OpenAI:               IA_PROVEEDOR=openai     IA_MODELO=<modelo>         IA_API_KEY=<clave>
# Otra API compatible   IA_PROVEEDOR=openai     IA_MODELO=<modelo>         IA_API_KEY=<clave>
#  (Groq, Gemini...):                           IA_BASE_URL=<url .../v1 del proveedor>
# Ollama local:         IA_PROVEEDOR=ollama     IA_MODELO=<modelo descargado>  (IA_BASE_URL opcional)
IA_PROVEEDOR=
IA_MODELO=
IA_API_KEY=cambiar-por-tu-clave
IA_BASE_URL=
IA_TIMEOUT_S=30
