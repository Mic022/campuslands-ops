# Copiar a .env y completar. Nunca subir .env al repositorio.

# Base de datos SQLite (ruta relativa a backend/)
DATABASE_URL=sqlite:///./campus.db

# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Proveedor de IA autorizado para la jornada (pendiente de confirmar)
# Valores previstos: anthropic | openai | ollama
IA_PROVEEDOR=
IA_MODELO=
IA_API_KEY=cambiar-por-tu-clave
IA_BASE_URL=
IA_TIMEOUT_S=15

# Token de operador para mantenimiento de salas e historial completo de reservas
ADMIN_TOKEN=cambiar-por-un-token-largo
